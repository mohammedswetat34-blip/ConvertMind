# ── REQUIRED ────────────────────────────────────────────────
# Anthropic API key — required for the /api/analyze endpoint.
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── OPTIONAL ─────────────────────────────────────────────────
# Stripe payment links — set these to enable the Pro and Agency buy buttons.
# If unset in production, buy buttons fall back to a mailto so a sale is never lost silently.
# Create payment links at https://dashboard.stripe.com/payment-links
# IMPORTANT: in each Payment Link's settings, set the confirmation page to
#   "Redirect customers to your website" → https://convertmind.ai/welcome.html
# so buyers land on the key-activation instructions instead of a generic receipt.
STRIPE_PRO_URL=https://buy.stripe.com/...
STRIPE_AGENCY_URL=https://buy.stripe.com/...

# Site URL — used for links inside transactional emails (/api/email-report).
# NOTE: the apex redirects to www — use the www origin everywhere.
SITE_URL=https://www.convertmind.xyz

# Resend API key — REQUIRED IN PRODUCTION for waitlist confirmations and
# "Email me this report". Without it, those endpoints return 503 on Vercel
# (locally they log and pretend success so the UI flow is testable).
# Get yours at https://resend.com/
RESEND_API_KEY=re_...

# From address for all outgoing email. The domain MUST be verified in Resend
# (unverified domains are rejected with 403).
EMAIL_FROM=ConvertMind <noreply@convertmind.xyz>

# Pro access password — the shared key you email to paying customers.
# Generate a random string (e.g. openssl rand -base64 16) and keep it secret.
# When a customer enters this key on the site they unlock the full Pro report.
# Rotate it by updating this value and notifying active subscribers.
PRO_PASSWORD=

# CORS allowed origin — restricts which origins may call the API from browsers.
# FAILS CLOSED: when unset, defaults to https://www.convertmind.xyz (production).
# Browser Origin headers carry the www host (apex 308s to www), so this must
# be the www variant. Same-origin frontend calls are unaffected either way.
# For local API development set this to * explicitly.
ALLOWED_ORIGIN=https://www.convertmind.xyz

# ── ABUSE / COST PROTECTION (Upstash Redis) ──────────────────
# Distributed rate limits + global Claude budget for /api/analyze, shared
# across all serverless instances. REQUIRED IN PRODUCTION: if these are unset
# on Vercel, /api/analyze fails closed with HTTP 503 (refuses to run
# unprotected). Locally they can be omitted — the app falls back to per-instance
# in-memory limits so you can still develop and run the tests.
# Create a free database at https://console.upstash.com/ (Redis) and copy the
# REST URL + token from its "REST API" section.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
