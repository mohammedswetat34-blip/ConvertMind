# ── REQUIRED ────────────────────────────────────────────────
# Anthropic API key — required for the /api/analyze endpoint.
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── OPTIONAL ─────────────────────────────────────────────────
# Stripe payment links — set these to enable the Pro and Agency buy buttons.
# If unset in production, buy buttons fall back to a mailto so a sale is never lost silently.
# Create payment links at https://dashboard.stripe.com/payment-links
# IMPORTANT: in each Payment Link's settings, set the confirmation page to
#   "Redirect customers to your website" → https://convertmind.ai/welcome.html
# so buyers land on the key-activation instructions instead of a generic receipt.
STRIPE_PRO_URL=https://buy.stripe.com/...
STRIPE_AGENCY_URL=https://buy.stripe.com/...

# Site URL — used for links inside transactional emails (/api/email-report).
SITE_URL=https://convertmind.ai

# Resend API key — if set, sends a confirmation email to waitlist signups.
# Without this key, signups are only logged to the serverless function console.
# Get yours at https://resend.com/
RESEND_API_KEY=re_...

# Pro access password — the shared key you email to paying customers.
# Generate a random string (e.g. openssl rand -base64 16) and keep it secret.
# When a customer enters this key on the site they unlock the full Pro report.
# Rotate it by updating this value and notifying active subscribers.
PRO_PASSWORD=

# CORS allowed origin — restricts which origins may call the API.
# Default is * (any origin). Set to your production domain to lock it down.
# Example: ALLOWED_ORIGIN=https://convertmind.ai
ALLOWED_ORIGIN=*
